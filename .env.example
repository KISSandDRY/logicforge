# Root / Client / Server Environment Example (copy cleanly to client/.env or server/.env)
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/logicforge_db?schema=public"
JWT_SECRET="replace-with-a-random-32-plus-character-secret-before-prod"
JWT_EXPIRES_IN="24h"
BCRYPT_COST=12
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
USE_EMBEDDED_DB=false
ENABLE_DEMO_AUTH=false
VITE_API_URL="/api"
