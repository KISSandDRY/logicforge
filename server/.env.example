# LogicForge Backend Environment Configuration
# Copy to .env for local development and replace all secrets before deployment.
PORT=4000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/logicforge_db?schema=public"
# Must be at least 32 random characters in production (e.g. `openssl rand -hex 32`)
JWT_SECRET="replace-with-a-random-32-plus-character-secret-before-prod"
JWT_EXPIRES_IN="24h"
BCRYPT_COST=12
# Comma-separated explicit origin allowlist (never use '*' in production)
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"
USE_EMBEDDED_DB=false
ENABLE_DEMO_AUTH=true
